# Opt-in: existing Railway build/start configuration is unchanged.
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl bzip2 util-linux && rm -rf /var/lib/apt/lists/*
COPY scripts/install-restic.sh /tmp/install-restic.sh
RUN bash /tmp/install-restic.sh /usr/local/bin/restic && rm /tmp/install-restic.sh
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY app ./app
COPY components ./components
COPY content ./content
COPY lib ./lib
COPY public ./public
COPY scripts ./scripts
COPY next.config.ts next-env.d.ts tsconfig.json ./
# Keep TypeScript installed: Next loads next.config.ts when starting production.
RUN npm run build
ENV NODE_ENV=production
ENV BACKUP_ENABLED=0
CMD ["node", "scripts/start-with-backup.mjs"]
